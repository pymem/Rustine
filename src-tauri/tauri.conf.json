{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustine",
  "version": "0.1.0",
  "identifier": "com.rustine.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rustine",
        "width": 640,
        "height": 415,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
